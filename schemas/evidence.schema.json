{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaia-discovery-v3/schemas/evidence.schema.json",
  "title": "Evidence payload (sub-agent \u5199\u5230 task_results/<action_id>.evidence.json)",
  "description": "\u4e0e gd.verify_server.schemas.EvidencePayload pydantic \u6a21\u578b\u4e00\u4e00\u5bf9\u5e94\u3002verify-server.routers.heuristic \u76f4\u63a5\u6d88\u8d39\u8fd9\u4e9b\u5b57\u6bb5\u3002",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "stance",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stance": {
      "enum": [
        "support",
        "refute",
        "inconclusive"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "premises": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Premise"
      }
    },
    "counter_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Premise"
      }
    },
    "uncertainty": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "formal_artifact": {
      "type": [
        "string",
        "null"
      ],
      "description": "\u53ef\u9009\u7684 .lean / .py \u5f62\u5f0f\u5316\u8bc1\u636e\u8def\u5f84\uff08\u76f8\u5bf9 project_dir\uff09"
    },
    "action_id": {
      "type": "string",
      "description": "\u5bf9\u5e94 dispatch \u6d3e\u51fa\u7684 ActionSignal.action_id\uff08sub-agent \u5fc5\u987b\u586b\uff09"
    }
  },
  "$defs": {
    "Premise": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0,
          "maximum": 1.0
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0,
          "maximum": 1.0
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}