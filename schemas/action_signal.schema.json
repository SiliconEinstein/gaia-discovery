{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaia-discovery-v3/schemas/action_signal.schema.json",
  "title": "ActionSignal envelope",
  "description": "gd dispatch <project_dir> \u7684\u6807\u51c6\u8f93\u51fa\u3002",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_dir",
    "plan_path",
    "actions",
    "rejected",
    "cycle_state"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_dir": {
      "type": "string",
      "description": "\u63a2\u7d22\u9879\u76ee\u6839\u76ee\u5f55\u7edd\u5bf9\u8def\u5f84"
    },
    "plan_path": {
      "type": "string",
      "description": "plan.gaia.py \u7edd\u5bf9\u8def\u5f84"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Action"
      },
      "description": "\u672c\u8f6e\u5168\u90e8 pending action \u6e05\u5355"
    },
    "rejected": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rejected"
      },
      "description": "metadata.action \u4e0d\u5728\u767d\u540d\u5355 / args \u5f62\u6001\u975e\u6cd5\u7b49\u88ab\u62d2\u539f\u56e0"
    },
    "cycle_state": {
      "$ref": "cycle_state.schema.json"
    }
  },
  "$defs": {
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_kind",
        "claim_qid",
        "args",
        "metadata"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "action_kind": {
          "type": "string",
          "enum": [
            "abduction",
            "contradict",
            "derive",
            "disjunction",
            "equal",
            "exclusive",
            "induction",
            "infer"
          ]
        },
        "claim_qid": {
          "type": "string"
        },
        "claim_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        },
        "lean_target": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "claim_qid"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "claim_qid": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_action": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}